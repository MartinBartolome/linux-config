#!/bin/bash
# run_onchange_after_install-desktop-apps-general.sh
# Installs general-purpose desktop applications via yay.
{{- if not .desktop }}
exit 0
{{- end }}
set -euo pipefail

PACKAGES=(
    brave-browser
)

echo "==> Installing general apps..."

for pkg in "${PACKAGES[@]}"; do
    if ! pacman -Q "$pkg" &>/dev/null; then
        echo "  -> Installing $pkg..."
        yay -S --noconfirm --needed "$pkg"
    else
        echo "  -> $pkg already installed"
    fi
done

echo "==> General apps installation completed"
